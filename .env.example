# Email Configuration
# These are required for the contact form to work

# Clinic sender email (used to send notifications to clinic)
CLINIC_EMAIL=your-clinic-sender@gmail.com

# Gmail App Password for clinic sender email
# Get this from: https://myaccount.google.com/apppasswords
CLINIC_EMAIL_PASSWORD=your-gmail-app-password

# User/Support email (used to send confirmation emails to users)
USER_EMAIL=your-support-email@gmail.com

# Gmail App Password for user/support email
USER_EMAIL_PASSWORD=your-gmail-app-password

# Clinic recipient email (where clinic notifications are sent)
# If not set, defaults to USER_EMAIL
CLINIC_RECIPIENT_EMAIL=your-clinic-recipient@gmail.com
